# NOTE: git .gitignore does NOT support trailing comments — every comment must
# be on its own line, or the whole line (comment included) becomes the pattern.

# ---------------------------------------------------------------------------
# Downloaded payloads. NEVER committed. Re-fetch with scripts_setup/gate*.sh.
# checkpoints/ = 65 GB (FastWAM release ckpt + Wan2.2-TI2V-5B + LIBERO assets)
# LIBERO-Safety/ = 18 GB upstream clone + extracted assets
# FastWAM/ = upstream clone; our changes live in patches/ instead
# ---------------------------------------------------------------------------
checkpoints/
LIBERO-Safety/
FastWAM/

# ---------------------------------------------------------------------------
# Run outputs. Only the curated text/JSON evidence under evidence/ is tracked;
# the bulk (per-episode mp4 + full records.jsonl) is regenerated by the gates.
# ---------------------------------------------------------------------------
results/
logs/

# ---------------------------------------------------------------------------
# Python / editor noise
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.vscode/
.idea/
*.swp
.DS_Store
