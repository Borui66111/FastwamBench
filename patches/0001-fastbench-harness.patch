+# [fastbench] LIBERO-Safety stores bddl/init files under `<suite>/L<level>/`, while
+# upstream LIBERO keeps them flat in `<suite>/`. This resolver prefers the level
+# directory when the task exposes `level` and the file is there, otherwise falls
+# back to the flat upstream layout. Behaviour for the official LIBERO suites is
+# therefore unchanged (no `level` attribute -> flat path).
+def resolve_task_file_path(task, file_type: str, filename: str):
+    base = pathlib.Path(get_libero_path(file_type)) / task.problem_folder
+    level = getattr(task, "level", None)
+    candidates = []
+    if level is not None:
+        candidates.append(base / f"L{level}" / filename)
+    candidates.append(base / filename)
+    for candidate in candidates:
+        if candidate.exists():
+            return candidate
+    return candidates[-1]
+
 
