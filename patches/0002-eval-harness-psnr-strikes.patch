+def _clip_frame_psnr(gt_frames: list[Any], pred_frames: list[Any], eps: float = 1e-8) -> list[float]:
+    """Per-frame PSNR of a predicted-future clip (index k = k frames into the clip).
+
+    [fastbench] Gate 13 needs this because `_compute_clip_mean_psnr` averages over a
+    frame count that depends on `replan_steps`: H=1 compares ONE frame (lag 0) while
+    H=10 compares THREE (lags 0,4,8). Comparing those means across horizons is not
+    apples-to-apples -- a longer horizon is penalised simply for being scored further
+    into the future. Storing the per-frame values lets us compare the SAME lag.
+    """
+    out: list[float] = []
+    num_frames = min(len(gt_frames), len(pred_frames))
+    for gt_frame, pred_frame in zip(gt_frames[:num_frames], pred_frames[:num_frames]):
+        gt_image = _frame_to_rgb_array(gt_frame)
+        pred_image = _frame_to_rgb_array(pred_frame)
+        target_h, target_w = pred_image.shape[:2]
+        if gt_image.shape[:2] != (target_h, target_w):
+            gt_image = np.array(
+                Image.fromarray(gt_image).resize((target_w, target_h), resample=Image.BILINEAR)
+            )
+        gt_f32 = gt_image.astype(np.float32)
+        pred_f32 = pred_image.astype(np.float32)
+        mse = float(np.mean((pred_f32 - gt_f32) ** 2))
+        out.append(float(10.0 * np.log10((255.0 * 255.0) / max(mse, eps))))
+    return out
+
